{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@ai-md-editor/shared": ["packages/shared/src"],
      "@ai-md-editor/theme": ["packages/theme/src"],
      "@ai-md-editor/markdown-core": ["packages/markdown-core/src"],
      "@ai-md-editor/editor": ["packages/editor/src"]
    }
  },
  "include": ["apps", "packages"]
}
